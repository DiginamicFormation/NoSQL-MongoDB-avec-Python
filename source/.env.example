# Docker local (utilisateur applicatif créé par init/01-init.js)
MONGODB_URI=mongodb://app:app-password@localhost:27017/boutique?authSource=boutique
MONGODB_DB=boutique
APP_NAME=boutique

# Variante Atlas :
# MONGODB_URI=mongodb+srv://app:motdepasse@cluster0.ab1cd.mongodb.net/?retryWrites=true&w=majority

# Identifiants root du conteneur (lus par compose.yaml).
# Sans ces variables, le mot de passe root reste "change-moi".
MONGO_USER=admin
MONGO_PASSWORD=change-moi
MONGO_DB=boutique
