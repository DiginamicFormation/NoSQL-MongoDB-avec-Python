# Copiez ce fichier en .env avant le premier `docker compose up -d`.

# L'API parle a Mongo par le reseau Docker : l'hote est `mongo`, pas `localhost`.
MONGODB_URI=mongodb://app:app-password@mongo:27017/pokedex?authSource=pokedex
MONGODB_DB=pokedex

# Identifiants root du conteneur, lus par compose.yaml.
MONGO_USER=admin
MONGO_PASSWORD=change-moi
MONGO_DB=pokedex

# Ports publies sur 127.0.0.1. Changez-les si l'un d'eux est deja pris.
PORT_WEB=8080
PORT_API=8000
PORT_MONGO=27018

# Depuis votre machine (mongosh, ou un script lance hors conteneur) :
# MONGODB_URI=mongodb://app:app-password@localhost:27018/pokedex?authSource=pokedex
